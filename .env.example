# Browser-safe Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Server-only values must never use the NEXT_PUBLIC_ prefix.
# Add a service-role key only when a reviewed server-side admin operation needs it.
SUPABASE_SERVICE_ROLE_KEY=

# Explicitly opt in only for the single-user SQLite presentation profile.
# Keep false for the formal Supabase deployment.
DOMEL_DEMO_MODE=false

# Optional AI enhancement. When omitted, Scenario Planning uses its built-in
# local assumption analyzer so the demonstration remains fully usable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Server-only Industry Intelligence research agent. Configure this as a
# runtime/deployment secret; never expose it with a NEXT_PUBLIC_ prefix.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
