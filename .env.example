# Browser-safe Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Server-only values must never use the NEXT_PUBLIC_ prefix.
# Add a service-role key only when a reviewed server-side admin operation needs it.
SUPABASE_SERVICE_ROLE_KEY=

# Explicitly opt in only for the single-user SQLite presentation profile.
# Keep false for the formal Supabase deployment.
DOMEL_DEMO_MODE=false

# Server-only AI provider for Scenario Planning and Industry Intelligence.
# When omitted, Scenario Planning uses its local analyzer and live research is disabled.
# Configure this only as a runtime/deployment secret; never use NEXT_PUBLIC_ here.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
