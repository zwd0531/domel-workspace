# Browser-safe Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Server-only values must never use the NEXT_PUBLIC_ prefix.
# Add a service-role key only when a reviewed server-side admin operation needs it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI enhancement. When omitted, Scenario Planning uses its built-in
# local assumption analyzer so the demonstration remains fully usable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
